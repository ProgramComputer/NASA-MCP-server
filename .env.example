# Copy to .env (never commit .env). Values here are placeholders.

# api.nasa.gov key for NEO and InSight weather.
# Get one at https://api.nasa.gov/ (DEMO_KEY works for light use).
# APOD, DONKI, TLE, SSC, TechPort, TechTransfer, Trek and the JPL tools need no key.
NASA_API_KEY=YOUR_NASA_API_KEY

# FIRMS MAP_KEY for nasa_firms (separate from NASA_API_KEY).
# Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY

# Transport: stdio (default) or http (Streamable HTTP).
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# Optional CMR override (UAT/SIT). https only, or http on localhost.
# NASA_MCP_CMR_URL=https://cmr.uat.earthdata.nasa.gov/search
