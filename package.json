{
  "name": "@programcomputer/nasa-mcp-server",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for NASA and JPL public APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nasa-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "npm run build && npm run build:test && node --test --test-concurrency=1 --test-timeout=120000 \".test-build/test/**/*.test.js\"",
    "test:live": "npm run build && npm run build:test && node --test --test-concurrency=1 \".test-build/test/live/*.live.js\"",
    "docs:tools": "npm run build && node scripts/generate-tool-docs.mjs",
    "docs:check": "npm run build && node scripts/generate-tool-docs.mjs --check",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepack": "node scripts/check-dist.mjs"
  },
  "keywords": [
    "nasa",
    "jpl",
    "earthdata",
    "cmr",
    "mcp",
    "model-context-protocol"
  ],
  "author": "ProgramComputer",
  "license": "ISC",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgramComputer/NASA-MCP-server.git"
  },
  "homepage": "https://github.com/ProgramComputer/NASA-MCP-server#readme",
  "bugs": {
    "url": "https://github.com/ProgramComputer/NASA-MCP-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
